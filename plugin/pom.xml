<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.gauchoracing</groupId>
  <artifactId>warden-plugin</artifactId>
  <version>1.3.0</version>
  <packaging>jar</packaging>
  <name>Warden</name>
  <description>Links Minecraft accounts to Sentinel and applies group-derived permissions</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Paper 26.2 requires Java 25 at minimum; the API is compiled for it. -->
    <maven.compiler.release>25</maven.compiler.release>
    <paper.version>26.2.build.129-stable</paper.version>
    <luckperms.version>5.5</luckperms.version>
    <!-- Shipped by the server. Declared only so records deserialize at compile time. -->
    <gson.version>2.11.0</gson.version>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Everything here is `provided`: Paper ships the server API, LuckPerms
         is a hard depend declared in plugin.yml, and Gson is on the server
         classpath already. Nothing needs shading, so there is no shade
         plugin and the jar stays a few KB. -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>net.luckperms</groupId>
      <artifactId>api</artifactId>
      <version>${luckperms.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.name}-${project.version}</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
    </plugins>
  </build>
</project>
