ENV=DEV
PORT=9999

DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=warden

SENTINEL_URL=https://sso.gauchoracing.com
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_REDIRECT_URI=http://localhost:10310/auth/login
SENTINEL_SA_TOKEN=

# Bearer the Minecraft plugin presents on /plugin/* routes. Generate with
# `openssl rand -hex 32`. This lives in a config file on the game server, so
# it is a lower-trust credential than the Sentinel client secret.
PLUGIN_TOKEN=

# Public origin players reach the link portal on (mc.gauchoracing.com in prod).
# Used to build the clickable link URL the plugin sends in chat.
PUBLIC_BASE_URL=http://localhost:10310

LINK_TOKEN_TTL=15m
GROUP_SYNC_INTERVAL=60s

# Server backups. The Depot origin and bucket are compiled in; the Sentinel
# service account above is the only credential involved, and backups stay off
# without it. Everything here is optional and shown at its default.
#
# BACKUP_TIMEZONE is the IANA zone cron schedules are evaluated in, so a 4am
# backup stays at 4am across a DST shift.
BACKUP_TIMEZONE=America/Los_Angeles
# How long before a scheduled backup players are warned, and the shorter
# grace period on the portal's "back up now" button.
BACKUP_WARNING_LEAD=5m
BACKUP_MANUAL_DELAY=10s
# When to give up on a backup the game server never reported the end of.
BACKUP_TIMEOUT=60m
